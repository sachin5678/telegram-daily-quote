{
  "name": "telegram-daily-quote",
  "version": "1.1.0",
  "description": "Send daily motivational quotes to a Telegram group (local schedule or GitHub Actions)",
  "main": "send-quote.js",
  "scripts": {
    "send": "node --env-file-if-exists=.env send-quote.js",
    "restore": "node --env-file-if-exists=.env scripts/restore-session.mjs",
    "export": "node scripts/export-session.mjs",
    "test": "node --env-file-if-exists=.env scripts/restore-session.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "telegram": "^2.26.22"
  }
}
